{
  "name": "@internal/site",
  "version": "0.0.0",
  "private": true,
  "description": "robkit.dev, the docs site. Astro builds it to static files in dist.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "pages-to-reread": "node scripts/pages-to-reread.ts",
    "lint": "astro sync && eslint .",
    "typecheck": "astro check && tsc",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage --project unit"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/mdx": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@robkit/dev": "workspace:*",
    "@robkit/session": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro": "catalog:",
    "create-robkit": "workspace:*",
    "eslint": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
