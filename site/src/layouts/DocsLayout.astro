---
// A docs page: the sidebar, the page, its headings, and the links to the
// pages before and after it. The sidebar is a column from 64rem wide and
// the phone menu below that. Without scripts it stays in the page, so
// every link works with none.
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import { markdownHref } from "../markdown-copies.ts";
import { buildNavigation } from "../navigation.ts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
  /** The page's id in the docs collection, such as `get-started/what-you-need`. */
  current: string;
  /** Whether the page isn't written yet. */
  stub: boolean;
  /** Where to edit the page's source on GitHub. */
  edit: string;
}

const { title, description, headings, current, stub, edit } = Astro.props;

const navigation = buildNavigation(
  (await getCollection("docs")).map(({ id, data }) => ({
    id,
    title: data.title,
    section: data.section,
    order: data.order,
  })),
);
const place = navigation.places[current];
if (place === undefined) throw new Error(`${current} isn't in the docs.`);
const onThisPage = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BaseLayout
  title={title}
  description={description}
  markdown={markdownHref(`/docs/${current}/`)}
  menu
>
  <div class="docs">
    <nav id="site-nav" class="sidebar" aria-label="Docs">
      {navigation.sections.map((section, index) => (
        <div class="section">
          <p class="section-title" id={`section-${String(index)}`}>
            {section.title}
          </p>
          <ul aria-labelledby={`section-${String(index)}`}>
            {section.pages.map((page) => (
              <li>
                <a
                  href={page.href}
                  aria-current={page.id === current ? "page" : undefined}
                >
                  {page.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <main id="main" class="page" tabindex="-1">
      <header class="page-head">
        <p class="eyebrow">{place.section}</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </header>
      {onThisPage.length > 0 && (
        <nav class="toc" aria-labelledby="toc-heading" data-toc>
          <p id="toc-heading" class="toc-title">
            On this page
          </p>
          <details class="toc-fold">
            <summary class="toc-heading">
              <span>On this page</span>
              <Icon name="chevron-down" size={16} />
            </summary>
            <ul>
              {onThisPage.map((heading) => (
                <li class={`depth-${String(heading.depth)}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      )}
      <div class="prose">
        {stub && (
          <p class="stub" data-stub>
            This page isn't written yet.
          </p>
        )}
        <slot />
      </div>
      <footer class="page-foot">
        <a class="edit" href={edit}>
          <Icon name="pen" size={16} />
          Edit this page on GitHub
        </a>
        {(place.previous ?? place.next) && (
          <nav class="pager" aria-label="Previous and next pages">
            {place.previous && (
              <a
                class="pager-link previous"
                href={place.previous.href}
                rel="prev"
              >
                <span class="pager-label">
                  <Icon name="arrow-left" size={16} />
                  Previous
                </span>
                <span class="pager-title">{place.previous.title}</span>
              </a>
            )}
            {place.next && (
              <a class="pager-link next" href={place.next.href} rel="next">
                <span class="pager-label">
                  Next
                  <Icon name="arrow-right" size={16} />
                </span>
                <span class="pager-title">{place.next.title}</span>
              </a>
            )}
          </nav>
        )}
      </footer>
    </main>
  </div>
</BaseLayout>

<script>
  import "../scripts/toc.ts";
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 90rem;
    margin: 0 auto;
  }

  .sidebar {
    padding: var(--space-6) var(--space-4);
    font-size: var(--text-sm);
  }

  .sidebar ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section + .section {
    margin-top: var(--space-6);
  }

  .section-title {
    margin: 0 0 var(--space-2);
    padding: 0 var(--space-3);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sidebar a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease);
  }

  .sidebar a:hover {
    background: var(--color-raised);
  }

  .sidebar a[aria-current="page"] {
    border-left-color: var(--color-accent);
    background: var(--color-raised);
    font-weight: 600;
  }

  /* At phone width with scripts, the list opens over the page. */
  @media (max-width: 63.999rem) {
    :global(html[data-js]) .sidebar {
      position: fixed;
      inset: var(--header-height) 0 0;
      z-index: 20;
      overflow-y: auto;
      border-top: 1px solid var(--color-border);
      background: var(--color-bg);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      transition:
        opacity var(--duration) var(--ease),
        transform var(--duration) var(--ease),
        visibility 0s linear var(--duration);
    }

    :global(html[data-js]) .sidebar[data-open] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }

    /* Without scripts, the list sits above the page, after a divider. */
    :global(html:not([data-js])) .sidebar {
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (min-width: 64rem) {
    .docs {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }

    .sidebar {
      position: sticky;
      top: var(--header-height);
      align-self: start;
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      border-right: 1px solid var(--color-border);
    }
  }

  .page {
    display: grid;
    grid-template-columns: minmax(0, var(--content-width));
    align-content: start;
    column-gap: var(--space-12);
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .page:focus {
    outline: none;
  }

  @media (min-width: 48rem) {
    .page {
      padding-inline: var(--space-8);
    }
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .page-head h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
  }

  .lead {
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  /* Below 80rem the list is folded above the text, and the reader opens it. */
  .toc {
    margin-bottom: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }

  .toc-title {
    display: none;
  }

  .toc-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-4);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease);
  }

  .toc-heading::-webkit-details-marker {
    display: none;
  }

  .toc-heading:hover {
    background: var(--color-raised);
  }

  .toc-heading :global(.icon) {
    color: var(--color-muted);
    transition: transform var(--duration-fast) var(--ease);
  }

  .toc-fold[open] .toc-heading :global(.icon) {
    transform: rotate(180deg);
  }

  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-fold ul {
    padding: 0 var(--space-4) var(--space-3);
  }

  .toc a {
    display: inline-block;
    padding: var(--space-1) 0;
    color: var(--color-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  /* The heading in view, which toc.ts marks as the page scrolls. */
  .toc a[aria-current="true"] {
    color: var(--color-link);
    font-weight: 600;
  }

  .toc .depth-3 {
    padding-left: var(--space-4);
  }

  @media (min-width: 80rem) {
    .page {
      grid-template-columns:
        minmax(0, var(--content-width))
        var(--toc-width);
    }

    .page-head,
    .prose,
    .page-foot {
      grid-column: 1;
    }

    .toc {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: start;
      margin: 0;
      padding: 0 0 0 var(--space-4);
      border: 0;
      border-left: 1px solid var(--color-border);
      border-radius: 0;
    }

    /*
     * A column has room for the whole list, so it shows unfolded, with no
     * fold to open, in CSS alone. A browser that can't style the fold's
     * content keeps the fold.
     */
    @supports selector(::details-content) {
      .toc-title {
        display: block;
        margin: 0 0 var(--space-2);
        font-family: var(--font-mono);
        font-weight: 600;
      }

      .toc-heading {
        display: none;
      }

      .toc-fold::details-content {
        content-visibility: visible;
      }

      .toc-fold ul {
        padding: 0;
      }
    }
  }

  .prose :global(h2) {
    margin: var(--space-12) 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .prose :global(h3) {
    margin: var(--space-8) 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-4);
  }

  .prose :global(li + li) {
    margin-top: var(--space-1);
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .stub {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-weight: 600;
  }

  .page-foot {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .edit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    font-size: var(--text-sm);
  }

  .pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease);
  }

  .pager-link:hover {
    border-color: var(--color-accent);
  }

  .pager-link.next {
    grid-column: -2;
    align-items: flex-end;
    text-align: right;
  }

  .pager-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .pager-title {
    color: var(--color-link);
    font-family: var(--font-mono);
    font-weight: 600;
  }
</style>
