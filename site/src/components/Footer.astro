---
import { repoUrl } from "../site.ts";
---

<footer class="footer">
  <p>
    robkit is open source under the{" "}
    <a href={`${repoUrl}/blob/main/LICENSE`}>MIT licence</a>. Found a problem?{" "}
    <a href={`${repoUrl}/issues`}>Open an issue on GitHub</a>.
  </p>
</footer>

<style>
  .footer {
    padding: var(--space-8) var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .footer p {
    margin: 0 auto;
    max-width: var(--content-width);
  }
</style>
