---
// Every icon the site draws, inline, in currentColor. Each is hidden from
// screen readers: the control around it carries the name.
// Sources: sun, moon, menu, x, square-terminal, arrow-left, arrow-right,
// square-pen, file, copy, check, info and triangle-alert from Lucide
// (https://lucide.dev, ISC licence); github from Simple Icons
// (https://simpleicons.org, CC0).

interface Props {
  name:
    | "sun"
    | "moon"
    | "menu"
    | "x"
    | "terminal"
    | "github"
    | "arrow-left"
    | "arrow-right"
    | "pen"
    | "file"
    | "copy"
    | "check"
    | "info"
    | "alert";
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={name === "github" ? "currentColor" : "none"}
  stroke={name === "github" ? "none" : "currentColor"}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class="icon"
>
  {name === "sun" && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </>
  )}
  {name === "moon" && <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />}
  {name === "menu" && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === "x" && <path d="M18 6 6 18M6 6l12 12" />}
  {name === "terminal" && (
    <>
      <rect width="18" height="18" x="3" y="3" rx="2" />
      <path d="m7 11 2-2-2-2m4 6h4" />
    </>
  )}
  {name === "arrow-left" && <path d="m12 19-7-7 7-7M19 12H5" />}
  {name === "arrow-right" && <path d="M5 12h14m-7-7 7 7-7 7" />}
  {name === "pen" && (
    <>
      <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
      <path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" />
    </>
  )}
  {name === "file" && (
    <>
      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
      <path d="M14 2v4a2 2 0 0 0 2 2h4" />
    </>
  )}
  {name === "copy" && (
    <>
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </>
  )}
  {name === "check" && <path d="M20 6 9 17l-5-5" />}
  {name === "info" && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="M12 16v-4M12 8h.01" />
    </>
  )}
  {name === "alert" && (
    <>
      <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
      <path d="M12 9v4M12 17h.01" />
    </>
  )}
  {name === "github" && (
    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
  )}
</svg>
