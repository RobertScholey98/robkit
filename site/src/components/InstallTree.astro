---
// Folders and files, each with what it's for. A new install's by default,
// from install-tree.ts, or an app's, from app-files.ts. A test finds each
// entry in the templates.
import { installTree, type TreeEntry } from "../install-tree.ts";

interface Props {
  entries?: TreeEntry[];
  /** Whether this is the tree's top, which names it. */
  top?: boolean;
  /** What the tree is, for a screen reader. */
  label?: string;
}

const {
  entries = installTree,
  top = true,
  label = "A new install",
} = Astro.props;
---

<ul class:list={["tree", { top }]} aria-label={top ? label : undefined}>
  {entries.map(({ name, about, children }) => (
    <li>
      <code>{name}</code>
      <span class="about">{about}</span>
      {children && <Astro.self entries={children} top={false} />}
    </li>
  ))}
</ul>

<style>
  .tree {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tree.top {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .tree .tree {
    margin-top: var(--space-2);
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-border);
  }

  li + li {
    margin-top: var(--space-3);
  }

  code {
    font-weight: 600;
  }

  .about {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
