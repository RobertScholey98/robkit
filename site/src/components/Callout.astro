---
// A note or a warning set apart from the page. Use them sparingly: a note
// for something a reader may want to know, a warning for something that
// can lose them work or data. Each says its kind in words, so colour isn't
// the only sign.
import Icon from "./Icon.astro";

interface Props {
  kind?: "note" | "warning";
}

const { kind = "note" } = Astro.props;
---

<div class="callout" data-kind={kind} role="note">
  <p class="kind">
    <Icon name={kind === "warning" ? "alert" : "info"} size={18} />
    {kind === "warning" ? "Warning" : "Note"}
  </p>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .callout {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-border-control);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .callout[data-kind="warning"] {
    border-left-color: var(--color-accent);
  }

  .kind {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .callout[data-kind="warning"] .kind :global(svg) {
    color: var(--color-accent);
  }

  .body > :global(:first-child) {
    margin-top: 0;
  }

  .body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
