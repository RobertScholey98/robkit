{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["packages/create-robkit/templates/base/compose.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@internal/e2e#test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
