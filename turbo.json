{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["packages/create-robkit/templates/base/compose.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "create-robkit#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tooling/eslint/*.js",
        "$TURBO_ROOT$/go/**"
      ]
    },
    "create-robkit#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ]
    },
    "create-robkit#test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ]
    },
    "@internal/site#lint": {
      "dependsOn": ["^build", "build"]
    },
    "@internal/site#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/GLOSSARY.md",
        "$TURBO_ROOT$/SECURITY.md",
        "$TURBO_ROOT$/docs/architecture.md",
        "$TURBO_ROOT$/packages/create-robkit/templates/**"
      ]
    },
    "@internal/site#test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/GLOSSARY.md",
        "$TURBO_ROOT$/SECURITY.md",
        "$TURBO_ROOT$/docs/architecture.md",
        "$TURBO_ROOT$/packages/create-robkit/templates/**"
      ]
    },
    "@internal/site#test:unit": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/GLOSSARY.md",
        "$TURBO_ROOT$/SECURITY.md",
        "$TURBO_ROOT$/docs/architecture.md",
        "$TURBO_ROOT$/packages/create-robkit/templates/**"
      ]
    },
    "@internal/go#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/guard/conformance.json"
      ]
    },
    "@internal/go#test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/guard/conformance.json"
      ]
    },
    "@internal/e2e#test": {
      "dependsOn": [
        "^build",
        "create-robkit#test",
        "@internal/repo-checks#typecheck"
      ],
      "cache": false
    },
    "@internal/repo-checks#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tooling/**",
        "$TURBO_ROOT$/go/**",
        "$TURBO_ROOT$/site/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.astro/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/GLOSSARY.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/CONTRIBUTING.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/renovate.json",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/.github/workflows/**"
      ]
    },
    "@internal/repo-checks#test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tooling/**",
        "$TURBO_ROOT$/go/**",
        "$TURBO_ROOT$/site/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.astro/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/GLOSSARY.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/CONTRIBUTING.md",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/renovate.json",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/.github/workflows/**"
      ]
    }
  }
}
