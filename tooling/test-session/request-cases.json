{
  "address": [
    {
      "name": "sends the browser back to the app's origin, worked out from core's",
      "core": "https://core.robkit.dev",
      "target": "/notes?x=1",
      "headers": { "host": "example.robkit.dev" },
      "next": "https://example.robkit.dev/notes?x=1"
    },
    {
      "name": "keeps https when the last proxy hop is plain http",
      "core": "https://core.robkit.dev",
      "target": "/notes?x=1",
      "headers": { "host": "example.robkit.dev", "x-forwarded-proto": "http" },
      "next": "https://example.robkit.dev/notes?x=1"
    },
    {
      "name": "keeps http when a request says https",
      "core": "http://core.robkit.localhost:3000",
      "target": "/notes?x=1",
      "headers": {
        "host": "example.robkit.localhost:3000",
        "x-forwarded-proto": "https"
      },
      "next": "http://example.robkit.localhost:3000/notes?x=1"
    },
    {
      "name": "ignores a forged Host",
      "core": "https://core.robkit.dev",
      "target": "/notes?x=1",
      "headers": { "host": "evil.com" },
      "next": "https://example.robkit.dev/notes?x=1"
    },
    {
      "name": "ignores a Host that names another port",
      "core": "http://core.robkit.localhost:3000",
      "target": "/notes?x=1",
      "headers": { "host": "example.robkit.localhost:4000" },
      "next": "http://example.robkit.localhost:3000/notes?x=1"
    },
    {
      "name": "ignores a forged X-Forwarded-Host",
      "core": "https://core.robkit.dev",
      "target": "/notes?x=1",
      "headers": {
        "host": "example.robkit.dev",
        "x-forwarded-host": "evil.com"
      },
      "next": "https://example.robkit.dev/notes?x=1"
    },
    {
      "name": "sends a signed-out visitor to the hub with next on the app's origin, whatever the headers say",
      "core": "https://core.robkit.dev",
      "target": "/notes?x=1",
      "headers": {
        "host": "evil.com",
        "x-forwarded-host": "evil.com",
        "x-forwarded-proto": "http"
      },
      "signedOut": true,
      "next": "https://example.robkit.dev/notes?x=1"
    },
    {
      "name": "takes a next on the app's origin at its refresh path, whatever the headers say",
      "core": "https://core.robkit.dev",
      "target": "/_robkit/refresh?next=https%3A%2F%2Fexample.robkit.dev%2Fnotes",
      "headers": { "host": "evil.com", "x-forwarded-proto": "http" },
      "next": "https://example.robkit.dev/notes"
    },
    {
      "name": "reads a target that starts with two slashes as a path on the app",
      "core": "https://core.robkit.dev",
      "target": "//evil.com/_robkit/refresh?next=https%3A%2F%2Fevil.com%2F",
      "headers": { "host": "example.robkit.dev" },
      "next": "https://example.robkit.dev//evil.com/_robkit/refresh?next=https%3A%2F%2Fevil.com%2F"
    },
    {
      "name": "guards a request that sends no Host",
      "core": "https://core.robkit.dev",
      "target": "/notes?x=1",
      "headers": {},
      "next": "https://example.robkit.dev/notes?x=1"
    },
    {
      "name": "guards a request whose Host is empty",
      "core": "https://core.robkit.dev",
      "target": "/notes?x=1",
      "headers": { "host": "" },
      "next": "https://example.robkit.dev/notes?x=1"
    }
  ],
