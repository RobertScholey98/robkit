{
  "name": "@internal/guestbook-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "vite build",
    "start": "node --run migrate && robkit-seed && node dist/serve.js",
    "migrate": "node src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@internal/ui": "workspace:*",
    "@robkit/dev": "0.0.0",
    "@robkit/hono": "0.0.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/vite-dev-server": "0.26.1",
    "@internal/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "robkit": {
    "name": "Guestbook",
    "description": "A guestbook anyone can read and anyone signed in can sign.",
    "stack": "react-hono",
    "contract": 1,
    "access": {
      "kind": "open"
    },
    "icon": "📖"
  },
  "packageManager": "pnpm@11.28.9"
}
