{
  "name": "@robkit/provision",
  "version": "0.0.0",
  "description": "Gives each app of a robkit install its own Postgres schema and role.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@robkit/input": "workspace:*",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/test-postgres": "workspace:*",
    "@internal/test-session": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
