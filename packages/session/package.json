{
  "name": "@robkit/session",
  "version": "0.0.0",
  "description": "robkit's session token: its claims, its cookie and how apps verify it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app-env": "./src/app-env.ts",
    "./addresses": "./src/install-addresses.ts",
    "./input": "./src/input.ts",
    "./lapsed": "./src/session-lapsed.ts",
    "./manifest": "./src/manifest.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./app-env": {
        "types": "./dist/app-env.d.ts",
        "default": "./dist/app-env.js"
      },
      "./addresses": {
        "types": "./dist/install-addresses.d.ts",
        "default": "./dist/install-addresses.js"
      },
      "./input": {
        "types": "./dist/input.d.ts",
        "default": "./dist/input.js"
      },
      "./lapsed": {
        "types": "./dist/session-lapsed.d.ts",
        "default": "./dist/session-lapsed.js"
      },
      "./manifest": {
        "types": "./dist/manifest.d.ts",
        "default": "./dist/manifest.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --typecheck --coverage",
    "test:unit": "vitest run --typecheck --coverage"
  },
  "dependencies": {
    "@robkit/guard": "workspace:*",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/test-session": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
