{
  "name": "@robkit/vite",
  "version": "0.0.0",
  "description": "Everything robkit adds to Vite: robkit(), which sets an app's dev server up behind pnpm dev's proxy, and the handoff an Express app needs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./express": "./src/express.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./express": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage"
  },
  "dependencies": {
    "@robkit/input": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:"
  }
}
