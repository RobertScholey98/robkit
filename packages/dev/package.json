{
  "name": "@robkit/dev",
  "version": "0.0.0",
  "description": "robkit's local dev runner and proxy.",
  "type": "module",
  "bin": {
    "robkit-dev": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/test-postgres": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
