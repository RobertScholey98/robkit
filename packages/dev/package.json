{
  "name": "@robkit/dev",
  "version": "0.0.0",
  "description": "robkit's local dev runner and proxy.",
  "type": "module",
  "bin": {
    "robkit-dev": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      }
    },
    "bin": {
      "robkit-dev": "./dist/bin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@robkit/input": "workspace:*",
    "@robkit/session": "workspace:*",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/test-postgres": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
