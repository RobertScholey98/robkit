[
  {
    "name": "an open app lets a signed-out visitor in as nobody",
    "rule": { "kind": "open" },
    "session": "signed-out",
    "outcome": "allow"
  },
  {
    "name": "an open app refreshes an expired token, so the app sees who it is",
    "rule": { "kind": "open" },
    "session": "expired",
    "outcome": "refresh"
  },
  {
    "name": "an open app lets the owner in",
    "rule": { "kind": "open" },
    "session": "owner",
    "outcome": "allow"
  },
  {
    "name": "an open app lets a guest in",
    "rule": { "kind": "open" },
    "session": "guest",
    "outcome": "allow"
  },
  {
    "name": "an owner-only app sends a signed-out visitor to log in",
    "rule": { "kind": "owner" },
    "session": "signed-out",
    "outcome": "login"
  },
  {
    "name": "an owner-only app refreshes an expired token",
    "rule": { "kind": "owner" },
    "session": "expired",
    "outcome": "refresh"
  },
  {
    "name": "an owner-only app lets the owner in",
    "rule": { "kind": "owner" },
    "session": "owner",
    "outcome": "allow"
  },
  {
    "name": "an owner-only app answers a guest with not found",
    "rule": { "kind": "owner" },
    "session": "guest",
    "outcome": "not-found"
  },
  {
    "name": "an owner-only app answers a guest with not found, whatever their roles",
    "rule": { "kind": "owner" },
    "session": "guest",
    "guestRoles": ["family"],
    "outcome": "not-found"
  },
  {
    "name": "a role-gated app sends a signed-out visitor to log in",
    "rule": { "kind": "roles", "roles": ["family"] },
    "session": "signed-out",
    "outcome": "login"
  },
  {
    "name": "a role-gated app refreshes an expired token",
    "rule": { "kind": "roles", "roles": ["family"] },
    "session": "expired",
    "outcome": "refresh"
  },
  {
    "name": "a role-gated app lets the owner in",
    "rule": { "kind": "roles", "roles": ["family"] },
    "session": "owner",
    "outcome": "allow"
  },
  {
    "name": "a role-gated app lets in a guest who holds its role",
    "rule": { "kind": "roles", "roles": ["family"] },
    "session": "guest",
    "guestRoles": ["family"],
    "outcome": "allow"
  },
  {
    "name": "a role-gated app lets in a guest who holds any one of its roles",
    "rule": { "kind": "roles", "roles": ["family", "friends"] },
    "session": "guest",
    "guestRoles": ["book-club", "friends"],
    "outcome": "allow"
  },
  {
    "name": "a role-gated app answers a guest with another role with not found",
    "rule": { "kind": "roles", "roles": ["family"] },
    "session": "guest",
    "guestRoles": ["friends"],
    "outcome": "not-found"
  },
  {
    "name": "a role-gated app answers a guest with no roles with not found",
    "rule": { "kind": "roles", "roles": ["family"] },
    "session": "guest",
    "outcome": "not-found"
  },
  {
    "name": "an open app lets a guest with roles in",
    "rule": { "kind": "open" },
    "session": "guest",
    "guestRoles": ["family"],
    "outcome": "allow"
  }
]
