{
  "name": "@robkit/guard",
  "version": "0.0.0",
  "description": "robkit's guard: the pure decision of who may open an app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertScholey98/robkit.git",
    "directory": "packages/guard"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./testing": "./src/testing.ts",
    "./conformance.json": "./conformance.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./conformance": {
        "types": "./dist/src/conformance.d.ts",
        "default": "./dist/src/conformance.js"
      },
      "./testing": {
        "types": "./dist/src/testing.d.ts",
        "default": "./dist/src/testing.js"
      },
      "./conformance.json": "./conformance.json"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/test",
    "conformance.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --typecheck --coverage",
    "test:unit": "vitest run --typecheck --coverage"
  },
  "dependencies": {
    "@robkit/input": "workspace:*"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
