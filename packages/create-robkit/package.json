{
  "name": "create-robkit",
  "version": "0.0.0",
  "description": "Writes a robkit install: core, the hub, admin, one Postgres and an example app.",
  "type": "module",
  "bin": {
    "create-robkit": "./src/bin.ts",
    "robkit": "./src/robkit.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test",
    "!src/**/__snapshots__",
    "templates"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@robkit/dev": "workspace:*",
    "@robkit/session": "workspace:*",
    "prettier": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
