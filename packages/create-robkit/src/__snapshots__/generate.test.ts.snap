exports[`generateInstall > writes the default install > pnpm-workspace.yaml 1`] = `
"packages:
  - apps/*
  - packages/*
  - tooling/*

# Manifests say \`catalog:\`, so every external version lives in the catalog.
catalogMode: strict

# esbuild ships its binary as an optional dependency, so its install script
# has nothing to do.
allowBuilds:
  esbuild: false
catalog:
  "@eslint/js": 10.0.1
  "@fontsource-variable/geist": 5.3.0
  "@hono/node-server": 2.1.5
  "@hono/vite-dev-server": 0.26.1
  "@robkit/core": 0.0.0
