exports[`generateInstall > writes the default install > pnpm-workspace.yaml 1`] = `
"packages:
  - apps/*
  - packages/*
  - tooling/*

# Manifests say \`catalog:\`, so every external version lives in the catalog.
catalogMode: strict

# esbuild ships its binary as an optional dependency, so its install script
# has nothing to do.
allowBuilds:
  esbuild: false
catalog:
  "@eslint/js": 10.0.1
  "@hono/node-server": 2.1.5
  "@hono/vite-dev-server": 0.26.1
  "@robkit/core": 0.0.0
  "@robkit/dev": 0.0.0
  "@robkit/guard": 0.0.0
  "@robkit/hono": 0.0.0
  "@robkit/react": 0.0.0
  "@robkit/session": 0.0.0
  "@robkit/start": 0.0.0
  "@tailwindcss/vite": 4.3.3
  "@tanstack/react-router": 1.170.46
  "@tanstack/react-start": 1.169.4
  "@types/node": 26.6.5
  "@types/react": 19.3.0
  "@types/react-dom": 19.3.0
  "@vitejs/plugin-react": 6.1.2
  create-robkit: 0.0.0
  eslint: 10.13.0
  globals: 17.13.0
  hono: 4.13.14
  postgres: 3.4.9
  prettier: 3.9.10
  react: 19.3.1
  react-dom: 19.3.1
  tailwindcss: 4.3.3
  turbo: 2.11.10
  typescript: 6.0.3
  typescript-eslint: 8.72.1
  vite: 8.3.5
  vitest: 5.0.5
"
`;

