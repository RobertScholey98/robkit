"packages:
  - apps/*
  - packages/*
  - tooling/*

# Manifests say \`catalog:\`, so every external version lives in the catalog.
catalogMode: strict

# esbuild ships its binary as an optional dependency, so its install script
# has nothing to do.
allowBuilds:
  esbuild: false
catalog:
  "@base-ui/react": 1.9.0
