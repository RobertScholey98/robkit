{
  "extends": "@internal/tsconfig/base.json",
  "compilerOptions": {
    // Chakra's type declarations import their own files without extensions,
    // which only bundler resolution follows. Vite bundles this code anyway.
    "module": "preserve",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["src", "*.js", "*.ts"]
}
