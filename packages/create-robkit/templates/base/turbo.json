{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "inputs": [
        "**",
        "!node_modules/**",
        "!.git/**",
        "!.turbo/**",
        "!dist/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "inputs": ["**", "!node_modules/**", "!.git/**", "!.turbo/**", "!dist/**"]
    },
    "test": {
      "inputs": ["**", "!node_modules/**", "!.git/**", "!.turbo/**", "!dist/**"]
    }
  }
}
