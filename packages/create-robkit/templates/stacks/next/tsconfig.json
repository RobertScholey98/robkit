{
  "extends": "@internal/tsconfig/base.json",
  "compilerOptions": {
    // Next bundles the app, so imports resolve as a bundler's do.
    "module": "preserve",
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node", "next", "next/image-types/global"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "*.js", "*.ts"],
  // next dev and next build write it, naming types under dist that may be
  // gone. The types above hold what it declares, an imported image's among
  // them.
  "exclude": ["next-env.d.ts"]
}
