{
  "name": "@robkit/start",
  "version": "0.0.0",
  "description": "robkit's TanStack Start adapter: runs the guard and hands server functions the viewer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertScholey98/robkit.git",
    "directory": "packages/start"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./serve": "./src/serve.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./serve": {
        "types": "./dist/serve.d.ts",
        "default": "./dist/serve.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --typecheck --coverage",
    "test:unit": "vitest run --typecheck --coverage"
  },
  "dependencies": {
    "@robkit/guard": "workspace:*",
    "@robkit/input": "workspace:*",
    "@robkit/serve": "workspace:*",
    "@robkit/session": "workspace:*",
    "srvx": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1.169.4"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/test-session": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@tanstack/react-start": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
