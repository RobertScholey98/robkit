{
  "name": "@robkit/drizzle",
  "version": "0.0.0",
  "description": "Gives a robkit app its Drizzle database and applies its migrations in its own schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertScholey98/robkit.git",
    "directory": "packages/drizzle"
  },
  "type": "module",
  "bin": {
    "robkit-migrate": "./src/robkit-migrate-command.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "robkit-migrate": "./dist/robkit-migrate-command.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@robkit/input": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/test-postgres": "workspace:*",
    "@internal/test-session": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@robkit/provision": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
