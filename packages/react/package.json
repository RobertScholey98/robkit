{
  "name": "@robkit/react",
  "version": "0.0.0",
  "description": "robkit's client helper: sends the browser through core's refresh when a session lapses, and hands every other answer to the caller.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertScholey98/robkit.git",
    "directory": "packages/react"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --typecheck --coverage",
    "test:unit": "vitest run --typecheck --coverage"
  },
  "dependencies": {
    "@robkit/session": "workspace:*"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
